// Cloudflare Worker that serves the built site (_site) and the contact form endpoint.
// Deployed by Workers Builds: build command `npm run build`, deploy command `npx wrangler deploy`
// (branch previews: `npx wrangler preview`).
{
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the form endpoint runs code; every page and image is served straight from the edge.
    "run_worker_first": ["/api/*"]
  },
  // Sends the form message to Georgia's inbox (address set as the CONTACT_TO secret, never in this repo).
  "send_email": [{ "name": "EMAIL" }],
  // Keep variables added in the dashboard when a new build deploys.
  "keep_vars": true,
  "vars": {
    "CONTACT_FROM": "form@georgiasweeny.com"
  },
  "observability": { "enabled": true },
  // Branch builds deploy with `npx wrangler preview`, which needs the preview environment spelled out.
  // Same sender and email binding as production; the form only ever sends to Georgia's own inbox.
  "previews": {
    "vars": {
      "CONTACT_FROM": "form@georgiasweeny.com"
    },
    "send_email": [{ "name": "EMAIL" }]
  }
}
