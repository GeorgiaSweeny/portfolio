---
layout: layouts/base.njk
section: home
title: Georgia Sweeny
ogImage: src/_images/pat-banner.jpg
---
{%- from "partials/icons.njk" import icon -%}
<main id="main" class="home-main">
  <section class="featured" id="featured" aria-labelledby="featured-h">
    <h2 id="featured-h" class="sr-only">Featured projects</h2>
    {%- asyncEach p in featured %}
    {%- set f = design.features[p.id] %}
    <article class="feature f-{{ f.mode }}{% if f.tone %} t-{{ f.tone }}{% endif %}" aria-labelledby="ft-{{ p.id }}">
      <div class="feature-media" aria-hidden="true">
        {%- if f.mode == "range" %}
        <div class="range"><div class="range-track">
          {%- asyncEach pass in [1, 2] %}
          {%- asyncEach im in f.images %}<div class="range-card">{% image p.dir + "/" + im, "", "(min-width: 1100px) 360px, (min-width: 700px) 300px, 220px" %}</div>{% endeach %}
          {%- endeach %}
        </div></div>
        {%- elif p.showcase.video %}
        <video muted loop playsinline preload="none" poster="{% imageFull p.showcase.poster %}" data-inview>
          {%- if p.showcase.webm %}<source src="{{ p.showcase.webm | mediaUrl }}" type="video/webm">{% endif %}
          <source src="{{ p.showcase.video | mediaUrl }}" type="video/mp4">
        </video>
        {%- endif %}
      </div>
      <div class="feature-text">
        <p class="meta">{{ p.disciplines | disciplineLabels }} <span>· {{ p.year }}</span></p>
        <h3 id="ft-{{ p.id }}"><a href="{{ p.url }}">{{ p.title }}</a></h3>
        <p class="role">{{ p.role }}</p>
        <p class="line">{{ p.featureText or p.outcome }}</p>
        <span class="go" aria-hidden="true">See the project{{ icon("arrow") }}</span>
      </div>
    </article>
    {%- endeach %}
  </section>
  <div class="all-projects"><a class="btn light outline" href="/projects/">All projects</a></div>
</main>
