---
layout: layouts/base.njk
---
{%- from "partials/icons.njk" import icon -%}
{#- Expects `project` (from content/, via project-pages.njk). #}
{%- set p = project %}
{%- set blocks = p.blocks %}
{%- set small = design.smallVideos %}
{#- Opening media, beside the description, in order of preference: the project's first full-size
    YouTube video (wherever it sits in its blocks), then its showcase clip, then its card image.
    design.openings can set a project to "video", "clip" or "image" instead. #}
{%- set fvIndex = blocks | openingVideoIndex(small) %}
{%- set hasClip = p.showcase and p.showcase.video %}
{%- set pick = (design.openings or {})[p.id] or ("video" if fvIndex >= 0 else ("clip" if hasClip else "image")) %}
{%- if pick == "video" and fvIndex < 0 %}{% set pick = "clip" if hasClip else "image" %}{% endif %}
{%- if pick == "clip" and not hasClip %}{% set pick = "image" %}{% endif %}
{%- set fv = blocks[fvIndex] if pick == "video" else false %}
{%- set heroVideo = p.showcase if pick == "clip" else false %}
{%- set ownToolNote = p.ownToolNote %}
{%- set keyImage = p.cardImage if pick == "image" else false %}
{%- set jump = blocks | headings %}
<main id="main" class="proj-main">
  {#- Hero: the opening media full-bleed, with the title over it (like a feature card on Home). #}
  <section class="proj-hero{% if fv %} has-video{% endif %}">
    <div class="proj-hero-media" style="{% if fv %}--ar:1.7778{% elif heroVideo %}--ar:{% imageRatio heroVideo.poster %};--w:{% imageWidth heroVideo.poster %}px{% else %}--ar:{% imageRatio keyImage %};--w:{% imageWidth keyImage %}px{% endif %}">
    {%- if fv %}
      <div class="video" data-youtube="{{ fv.youtube }}" data-title="{{ fv.label }}: {{ p.title }}">
        {% image fv.poster, "", "(min-width: 1500px) 1400px, 100vw", "", "eager" %}
        <button type="button" aria-label="{{ fv.label }} (loads YouTube)"><span>{{ icon("play") }}</span>{{ fv.label }}</button>
      </div>
    {%- elif heroVideo %}
      <video autoplay muted loop playsinline preload="metadata" poster="{% imageFull heroVideo.poster %}" aria-label="{{ heroVideo.alt }}" data-autoplay>
        {%- if heroVideo.webm %}<source src="{{ heroVideo.webm | mediaUrl }}" type="video/webm">{% endif %}
        <source src="{{ heroVideo.video | mediaUrl }}" type="video/mp4">
      </video>
    {%- else %}
      {% image keyImage, "", "(min-width: 1500px) 1400px, 100vw", "", "eager" %}
    {%- endif %}
    </div>
  </section>
  <header class="proj-hero-text">
    <p class="meta">{{ p.disciplines | disciplineLabels }} <span>· {{ p.year }}</span></p>
    <h1>{{ p.title }}</h1>
    <p class="proj-role">{{ p.role }}</p>
  </header>

  {%- if p.links %}
  <div class="proj-actions"><div class="wrap">
    <p class="links">
      {%- for l in p.links %}
      <a class="btn{% if not loop.first or l.youtube %} outline{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener">{% if l.youtube %}{{ icon("youtube") }}{% endif %}{{ l.label }}</a>
      {%- endfor %}
    </p>
  </div></div>
  {%- endif %}

  {%- if jump.length > 1 %}
  {#- Jump links to the galleries: sit under the buttons, then stick to the top while you scroll. #}
  <nav class="proj-jump" aria-label="Sections of this project"><div class="wrap"><div class="chips">
    <span>Jump to</span>
    {%- for h in jump %}<a href="#{{ h | slugify }}">{{ h }}</a>{% endfor %}
  </div></div></nav>
  {%- endif %}

  <div class="proj-open"><div class="wrap">
    <div class="proj-cols">
      <div class="proj-intro">
        {%- for para in p.intro | paras %}
        <p class="intro">{{ para }}</p>
        {%- endfor %}
        {%- if p.ownTool and not ownToolNote %}<p class="owntool">Made With One of My Own Tools{{ icon("tool") }}</p>{% endif %}
      </div>
      <div class="proj-aside">
        <dl class="facts">
          <div><dt>My Role</dt><dd>{{ p.facts.role }}</dd></div>
          <div><dt>Tools</dt><dd>{{ p.facts.tools }}</dd></div>
          <div><dt>Outcome</dt><dd>{{ p.facts.outcome }}</dd></div>
        </dl>
        {%- if ownToolNote %}
        <aside class="owntool-box" aria-label="Made with one of my own tools">
          <p class="owntool">Made With One of My Own Tools{{ icon("tool") }}</p>
          <p class="serif">{{ ownToolNote }}</p>
          <div class="pills">
            {%- for l in p.ownToolLinks %}
              {%- set target = projects | projectBySlug(l.project) %}
              {%- if target %}<a class="pill" href="{{ target.url }}">{{ l.label }} →</a>{% endif %}
            {%- endfor %}
          </div>
        </aside>
        {%- endif %}
      </div>
    </div>
  </div></div>

  <div class="proj-body"><div class="wrap">
    {%- asyncEach b in blocks %}
      {%- if fv and loop.index0 == fvIndex %}{# opening video already shown beside the description #}
      {%- elif b.type == "video" %}
      {#- design.smallVideos = secondary clips, about half width on desktop, with an optional caption #}
      {%- set isSmall = b.youtube in small %}
      {%- if b.heading %}<h2 class="gallery-h" id="{{ b.heading | slugify }}">{{ b.heading }}</h2>{% endif %}
      <figure class="video-fig{% if isSmall %} small{% endif %}">
        <div class="video" data-youtube="{{ b.youtube }}" data-title="{{ b.label }}: {{ p.title }}">
          {% image b.poster, "", ("(min-width: 1100px) 640px, 100vw" if isSmall else "(min-width: 1328px) 1328px, 100vw") %}
          <button type="button" aria-label="{{ b.label }} (loads YouTube)"><span>{{ icon("play") }}</span>{{ b.label }}</button>
        </div>
        {%- if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
      </figure>
      {%- elif b.type == "gallery" %}
        {%- if b.heading %}<h2 class="gallery-h" id="{{ b.heading | slugify }}">{{ b.heading }}</h2>{% endif %}
        {%- set imgH = (design.galleryHeights[p.id] or {})[b.heading] %}
        <div class="gallery"{% if imgH %} style="--img-h:{{ imgH }}px"{% endif %}>
          {%- asyncEach im in b.images %}
          <figure class="{% if im.emphasis == "key" %}key{% elif im.group %}grouped{% endif %}" style="--ar:{% imageRatio im.src %}">
            {%- if im.video %}
            <div class="clip"><video autoplay muted loop playsinline preload="metadata" poster="{% imageFull im.src %}" aria-label="{{ im.alt }}" data-autoplay>
              {%- if im.webm %}<source src="{{ im.webm | mediaUrl }}" type="video/webm">{% endif %}
              <source src="{{ im.video | mediaUrl }}" type="video/mp4">
            </video></div>
            {%- else %}
            <a href="{% imageFull im.src %}" data-lightbox>{% image im.src, im.alt, "(min-width: 1100px) 50vw, (min-width: 700px) 60vw, 100vw" %}</a>
            {%- endif %}
            {%- if im.caption %}<figcaption>{{ im.caption }}</figcaption>{% endif %}
          </figure>
          {%- endeach %}
        </div>
      {%- endif %}
    {%- endeach %}


    {%- set nb = projects | neighbours(page.url) %}
    <nav class="pager" aria-label="More projects">
      <a href="{{ nb.prev.url }}">← {{ nb.prev.title }}</a>
      <a href="{{ nb.next.url }}">{{ nb.next.title }} →</a>
    </nav>
  </div></div>
</main>
