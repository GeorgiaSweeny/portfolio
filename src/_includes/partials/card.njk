{#- Project card. Expects `p` (a project from the projects data) and `flagship`, `sizes`. -#}
{%- from "partials/icons.njk" import icon -%}
<a class="card{% if flagship %} flagship{% endif %}" href="{{ p.url }}">
  <div class="shot">
    {%- if p.cardImage %}{% image p.cardImage, "", sizes %}{% else %}<div class="placeholder"></div>{% endif -%}
    {%- if p.draft %}<span class="draft-flag">Draft: hidden on the live site</span>{% endif -%}
  </div>
  <div class="text">
    <p class="meta">{{ p.disciplines | disciplineLabels }} <span>· {{ p.year }}</span></p>
    <h3>{{ p.title }}</h3>
    <p class="role">{{ p.role }}</p>
    <p class="outcome">{{ (p.outcomeLong if flagship and p.outcomeLong else p.outcome) }}</p>
    {%- if p.ownTool %}<p class="owntool">Made With One of My Own Tools{{ icon("tool") }}</p>{% endif %}
  </div>
</a>
