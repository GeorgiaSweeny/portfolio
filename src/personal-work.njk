---
layout: layouts/base.njk
section: personal
title: Personal Work
description: "Paintings, drawings and design pieces by Georgia Sweeny, made in her own time, alongside smaller commissions."
---
{%- set showPlaceholders = features.preview %}
<header class="page-head">
  <div class="wrap">
    <h1 class="cutout page-title">Personal Work</h1>
    <p class="lede">Paintings, drawings and design pieces made in my own time, alongside smaller commissions.</p>
    {%- if not artworks.length %}<p class="note">{% if showPlaceholders %}Placeholders show the layout until the photos, titles, media and sold list arrive.{% else %}Photos of my paintings and commissions are on their way.{% endif %}</p>{% endif %}
  </div>
</header>
<main id="main" class="page-main">
  <div class="wrap">
    <h2 class="sr-only">Artworks</h2>
    {%- if artworks.length %}
    <div class="tiles">
      {%- asyncEach a in artworks %}
      {#- Click a tile: the lightbox opens on the artwork (caption: title, medium and year, and its note),
          and the arrows step through its sketches and progress shots, then on to the next artwork. #}
      <figure class="tile">
        <a class="img" href="{% imageFull a.image %}" data-lightbox data-caption="{{ a.title }}&#10;{{ a.medium }} · {{ a.year }}{% if a.note %}&#10;{{ a.note }}{% endif %}">{% image a.image, a.alt, "(min-width: 700px) 33vw, 50vw" %}{% if a.sold %}<span class="sold">Sold</span>{% endif %}{% if a.stages.length %}<span class="more" aria-hidden="true">+{{ a.stages.length }}</span>{% endif %}</a>
        {%- for s in a.stages %}
        <a hidden href="{% imageFull s.src %}" data-lightbox data-alt="{{ s.alt }}" data-caption="{{ a.title }}{% if s.caption %}: {{ s.caption }}{% endif %}">{{ s.alt }}</a>
        {%- endfor %}
        <figcaption><span class="t">{{ a.title }}</span><span class="m">{{ a.medium }} · {{ a.year }}{% if a.stages.length %} · {{ a.stages.length + 1 }} images{% endif %}</span></figcaption>
      </figure>
      {%- endeach %}
    </div>
    {%- elif showPlaceholders %}
    <div class="tiles">
      {%- for i in range(0, 9) %}
      <figure class="tile"><div class="img ph">{% if i % 3 == 0 %}<span class="sold">Sold</span>{% endif %}</div>
        <figcaption><span class="t">[Painting title]</span><span class="m">[Medium] · [Year]</span></figcaption></figure>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- set personalProjects = projects | inDiscipline("personal-work") %}
    {%- if personalProjects.length %}
    <div class="related">
      <span class="note">Personal projects</span>
      {%- for p in personalProjects %}<a class="pill" href="{{ p.url }}">{{ p.title }} →</a>{% endfor %}
    </div>
    {%- endif %}
  </div>
</main>
